--Write a query to retrieve the author_id, author_name, and publication_name for authors whose articles got zero views.
--The result should be sorted by author_id in ascending order.

--Return the result table sorted by id in ascending order.
SELECT 
    author_id,
    author_name,
    publication_name
FROM Views
WHERE view_count=0
ORDER BY author_id ASC


--Write a query to find the names of the top 3 distinct players by highest score who have won matches, including their scores.
SELECT DISTINCT 
  p.player_name, 
  p.score
FROM Players AS p
JOIN Matches AS m
ON m.winner = p.player_name
ORDER BY p.score DESC
LIMIT 3;

